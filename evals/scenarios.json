    "id": "ci_failure_with_evidence",
    "description": "A failed CI run should collect evidence and prepare an issue proposal.",
    "reports": {
      "get_ci_status": {
        "run_id": 42,
        "service": "backend",
        "status": "failed"
      },
      "get_failed_tests": {
        "run_id": 42,
        "tests": [
          {
            "name": "test_backend_is_ready",
            "message": "Expected HTTP 200, received HTTP 503."
          }
        ]
      },
      "read_logs": {
        "run_id": 42,
        "service": "backend",
        "entries": [
          {
            "level": "ERROR",
            "message": "Database readiness check failed."
          }
        ]
      },
      "get_service_status": {
        "service": "backend",
        "environment": "local",
        "status": "degraded"
      }
    },
    "expected": {
      "ci_status": "failed",
      "tool_calls": [
        "get_ci_status",
        "get_failed_tests",
        "read_logs",
        "get_service_status"
      ],
      "proposal": true,
      "errors": [],
      "required_evidence": [
        "test_backend_is_ready",
        "Database readiness check failed.",
        "Root cause is not established."
      ]
    }
  },
